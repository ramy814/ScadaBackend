{
  "name": "mog/project-helper",
  "version": "1.0.0",
  "description": "A Laravel package for mog projects",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Badr Ajjour",
      "email": "bajjour.89@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
    "mpdf/mpdf": "^8.2",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "Mog\\ProjectHelper\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mog\\ProjectHelper\\MogHelpersServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
