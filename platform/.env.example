APP_NAME="MOG Operations Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
# Must match the legacy backend (same Oracle timestamps and "today" windows).
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Production: oracle (the shared schema used by the legacy backend).
# Local demo: sqlite + `php artisan platform:demo` (local-only fixture, never production data).
DB_CONNECTION=oracle
ORACLE_DRIVER=sqlite
ORACLE_SQLITE_DATABASE=/absolute/path/to/platform/database/platform-demo.sqlite

# Oracle (production). The legacy names (DB_HOST, DB_SERVICE_NAME, DB_USERNAME, DB_PASSWORD, ...)
# are also accepted, so the legacy .env Oracle block can be pasted unchanged.
DB_TNS=
DB_ORACLE_HOST=
DB_ORACLE_PORT=1521
DB_ORACLE_DATABASE=
DB_ORACLE_SERVICE_NAME=
DB_ORACLE_USERNAME=
DB_ORACLE_PASSWORD=

# The platform owns no database tables: sessions and cache stay on disk so it can
# run beside the legacy backend without touching its schema.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=mog_platform_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# MOG SSO (requires the private mog/project-helper package on the server)
MOG_APP_NAME=platform
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DEFAULT_GUARD=admin

# Local development identity for /dev-login (APP_ENV=local only)
MOG_LOCAL_ADMIN_USER_ID=0
# SSO user IDs allowed to manage access and operations
MOG_PERMISSIONS_ADMIN_USER_IDS=

# Driver app SMS login: no SMS provider is integrated (same as legacy). Legacy silently
# accepted 000000; here a fixed code is accepted ONLY if set below. Leave empty to block it.
SMS_TEST_CODE=

# Mobile API response locale (legacy runs APP_LOCALE=en).
MOBILE_API_LOCALE=en

DRIVER_APP_LATEST_VERSION=1.1.19
DRIVER_APP_LATEST_BUILD=42
DRIVER_APP_RECENT_DAYS=14

VITE_APP_NAME="${APP_NAME}"

# Wells photos are written by the legacy backend; point this at its storage/app/private.
LEGACY_MEDIA_ROOT=

# GeoServer (valves GeoServer map mode). Credentials stay on the server.
GEOSERVER_BASE_URL=https://geo.mogaza.org/geoserver
GEOSERVER_USERNAME=
GEOSERVER_PASSWORD=
