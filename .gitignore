# Frontend: `npm run build` writes to public/build (ignored, as in the legacy backend).
# The release build committed for production lives in public/build-platform (npm run build:release).
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail

# Server-local files: the production checkout keeps its own copies (ignored since the
# legacy backend). Tracking them would make the automatic `git pull` deploy fail.
# The platform works with those copies or without them (AppServiceProvider fallbacks).
/composer.lock
/package-lock.json
/config/app.php
/config/database.php
/config/filesystems.php
/config/session.php

# graphify: commit the graph and report; local cache and machine-specific build state stay out.
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/.graphify_*
